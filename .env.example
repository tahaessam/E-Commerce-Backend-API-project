# Application
NODE_ENV=development
PORT=3000

# MongoDB
DB_URL=mongodb://127.0.0.1:27017/ecommerce

# Redis
REDIS_URL=redis://127.0.0.1:6379

# JWT - use long, random, different secrets for access and refresh tokens
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_HMAC_SECRET=replace-with-a-third-long-random-secret

# OTP
OTP_LENGTH=6
OTP_EXPIRES_IN=300
OTP_HMAC_SECRET=replace-with-a-long-random-otp-secret

# Mail
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# Optional object storage
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=
