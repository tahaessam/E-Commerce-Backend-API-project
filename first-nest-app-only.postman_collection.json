                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nike Air Max 270\",\n  \"description\": \"The Nike Air Max 270 features the biggest Max Air unit yet, delivering exceptional cushioning and comfort for all-day wear.\",\n  \"price\": 149.99,\n  \"quantity\": 50,\n  \"category\": \"{{categoryId}}\",\n  \"brand\": \"{{brandId}}\",\n  \"seller\": \"{{sellerId}}\",\n  \"images\": [\n    \"https://static.nike.com/a/images/t_PDP_1728_v1/f_auto,q_auto:eco/air-max-270.jpg\"\n  ],\n  \"isAvailable\": true,\n  \"rating\": 4.5\n}"
            },
            "url": {
              "raw": "{{base_url}}/product",
              "host": ["{{base_url}}"],
              "path": ["product"]
            },
            "description": "Create a product. Requires `admin` or `seller` role.\n\n**Required fields:** `name`, `description`, `price`, `quantity`, `category`, `seller`\n**Optional fields:** `brand`, `images`, `isAvailable`, `soldCount`, `rating`\n\n⚠️ Make sure `{{categoryId}}`, `{{brandId}}`, and `{{sellerId}}` are set (run Create Category, Create Brand, Register Seller first).\n\nAuto-saves `productId`."
          }
        },
        {
          "name": "Create Product (Minimal)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Generic T-Shirt\",\n  \"description\": \"Basic cotton t-shirt in various sizes\",\n  \"price\": 19.99,\n  \"quantity\": 200,\n  \"category\": \"{{categoryId}}\",\n  \"seller\": \"{{sellerId}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/product",
              "host": ["{{base_url}}"],
              "path": ["product"]
            },
            "description": "Create a product with only the required fields (no brand, no images)."
          }
        },
        {
          "name": "Get All Products",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Response is array', () => pm.expect(json).to.be.an('array'));",
                  "if (Array.isArray(json) && json.length > 0) {",
                  "  pm.collectionVariables.set('productId', json[0]._id);",
                  "  console.log('Auto-saved productId:', json[0]._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/product",
              "host": ["{{base_url}}"],
              "path": ["product"],
              "query": [
                { "key": "search",      "value": "",       "disabled": true, "description": "Filter by product name (partial match, max 120 chars)" },
                { "key": "category",    "value": "",       "disabled": true, "description": "Filter by category ObjectId" },
                { "key": "brand",       "value": "",       "disabled": true, "description": "Filter by brand ObjectId" },
                { "key": "seller",      "value": "",       "disabled": true, "description": "Filter by seller ObjectId" },
                { "key": "minPrice",    "value": "0",      "disabled": true, "description": "Minimum price (inclusive)" },
                { "key": "maxPrice",    "value": "500",    "disabled": true, "description": "Maximum price (inclusive)" },
                { "key": "isAvailable", "value": "true",   "disabled": true, "description": "Filter by availability (true/false)" }
              ]
            },
            "description": "Fetch all products with optional filters.\n\n**Query params (all optional):**\n- `search` — name partial match\n- `category` — ObjectId\n- `brand` — ObjectId\n- `seller` — ObjectId\n- `minPrice` / `maxPrice` — price range\n- `isAvailable` — `true` or `false`"
          }
        },
        {
          "name": "Get Products — Filtered Example",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/product?minPrice=10&maxPrice=200&isAvailable=true",
              "host": ["{{base_url}}"],
              "path": ["product"],
              "query": [
                { "key": "minPrice",    "value": "10"   },
                { "key": "maxPrice",    "value": "200"  },
                { "key": "isAvailable", "value": "true" }
              ]
            },
            "description": "Example: Get available products priced between $10 and $200."
          }
        },
        {
          "name": "Get Product by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/product/{{productId}}",
              "host": ["{{base_url}}"],
              "path": ["product", "{{productId}}"]
            },
            "description": "Get a single product by MongoDB `_id`."
          }
        },
        {
          "name": "Update Product",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 129.99,\n  \"quantity\": 75,\n  \"description\": \"Updated — Nike Air Max 270 with improved comfort and style. Now on sale!\",\n  \"isAvailable\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/product/{{productId}}",
              "host": ["{{base_url}}"],
              "path": ["product", "{{productId}}"]
            },
            "description": "Partially update a product. Requires `admin` or `seller` role."
          }
        },
        {
          "name": "Delete Product",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/product/{{productId}}",
              "host": ["{{base_url}}"],
              "path": ["product", "{{productId}}"]
            },
            "description": "Delete a product by ID. Requires `admin` or `seller` role."
          }
        }
      ]
    },
