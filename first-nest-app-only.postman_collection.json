{
  "info": {
    "_postman_id": "f8e4bc7c-nest-api-collection",
    "name": "🚀 First NestJS App — Full API",
    "description": "Complete API collection for first-nest-app.\n\n**Base URL:** `{{base_url}}`  (default: http://localhost:3000)\n\n**Auth Flow:**\n1. Run **Register** to create an account\n2. Run **Login** to get tokens — `accessToken` & `refreshToken` are saved automatically\n3. All protected routes use `{{accessToken}}` in the Authorization header automatically\n\n**Roles:**\n- `admin` — Full access\n- `seller` — Can manage own products\n- `user` — Read-only access",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url",     "value": "http://localhost:3000", "type": "string" },
    { "key": "accessToken",  "value": "",                     "type": "string" },
    { "key": "refreshToken", "value": "",                     "type": "string" },
    { "key": "userId",       "value": "",                     "type": "string" },
    { "key": "brandId",      "value": "",                     "type": "string" },
    { "key": "categoryId",   "value": "",                     "type": "string" },
    { "key": "productId",    "value": "",                     "type": "string" },
    { "key": "sellerId",     "value": "",                     "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "🔐 Auth",
      "description": "Authentication endpoints — Register and Login. Public routes (no token required).",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  if (json.data && json.data._id) {",
                  "    pm.collectionVariables.set('userId', json.data._id);",
                  "    console.log('Saved userId:', json.data._id);",
                  "  }",
                  "  pm.test('Register successful', () => pm.expect(json.success).to.be.true);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@nestapp.com\",\n  \"password\": \"Admin@1234\",\n  \"username\": \"admin_taha\",\n  \"phoneNumber\": \"+201001234567\",\n  \"provider\": \"local\",\n  \"role\": \"admin\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            },
            "description": "Register a new user. Defaults to `admin` role for testing.\n\nAvailable roles: `admin`, `seller`, `user`\nAvailable providers: `local`, `google`, `facebook`"
          }
        },
        {
          "name": "Register (Seller)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  if (json.data && json.data._id) {",
                  "    pm.collectionVariables.set('sellerId', json.data._id);",
                  "    console.log('Saved sellerId:', json.data._id);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"seller@nestapp.com\",\n  \"password\": \"Seller@1234\",\n  \"username\": \"seller_one\",\n  \"phoneNumber\": \"+201009876543\",\n  \"provider\": \"local\",\n  \"role\": \"seller\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            },
            "description": "Register a seller account. The `sellerId` variable is auto-saved and used in Product creation."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  if (json.data) {",
                  "    pm.collectionVariables.set('accessToken', json.data.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', json.data.refreshToken);",
                  "    console.log('✅ Tokens saved successfully!');",
                  "    pm.test('Login successful', () => pm.expect(json.success).to.be.true);",
                  "    pm.test('accessToken present', () => pm.expect(json.data.accessToken).to.be.a('string'));",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@nestapp.com\",\n  \"password\": \"Admin@1234\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Login and receive JWT tokens.\n\n✅ **Auto-saves:** `accessToken` and `refreshToken` as collection variables.\nAll subsequent protected requests will use the saved token automatically."
          }
        },
        {
          "name": "Login (Seller)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  if (json.data) {",
                  "    pm.collectionVariables.set('accessToken', json.data.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', json.data.refreshToken);",
                  "    console.log('✅ Seller tokens saved!');",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"seller@nestapp.com\",\n  \"password\": \"Seller@1234\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Login as seller — switches `accessToken` to seller's token."
          }
        }
      ]
    },
    {
      "name": "👤 Users",
      "description": "User management endpoints.\n\n**Required role:** `admin` for create/update/delete, all roles for read.",
      "item": [
        {
          "name": "Create User (Admin only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  if (json._id) pm.collectionVariables.set('userId', json._id);",
                  "  pm.test('User created', () => pm.response.to.have.status(201));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"new_user_test\",\n  \"password\": \"User@1234\",\n  \"email\": \"newuser@nestapp.com\",\n  \"phoneNumber\": \"+201112223344\",\n  \"provider\": \"local\",\n  \"role\": \"user\",\n  \"isVerified\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/user",
              "host": ["{{base_url}}"],
              "path": ["user"]
            },
            "description": "Create a new user. Requires `admin` role.\n\nToken is auto-applied from collection-level auth."
          }
        },
        {
          "name": "Get All Users",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Response is array', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.be.an('array');",
                  "  if (json.length > 0) {",
                  "    pm.collectionVariables.set('userId', json[0]._id);",
                  "    console.log('Auto-saved first userId:', json[0]._id);",
                  "  }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/user",
              "host": ["{{base_url}}"],
              "path": ["user"]
            },
            "description": "Fetch all users. Available to `admin`, `seller`, `user` roles.\n\nAuto-saves the first result's `_id` as `userId`."
          }
        },
        {
          "name": "Get User by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/user/{{userId}}",
              "host": ["{{base_url}}"],
              "path": ["user", "{{userId}}"]
            },
            "description": "Fetch a single user by MongoDB `_id`.\n\nUses `{{userId}}` variable — set it from **Get All Users** or **Create User** responses."
          }
        },
        {
          "name": "Update User (Admin only)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"updated_username\",\n  \"phoneNumber\": \"+201119998877\",\n  \"isVerified\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/user/{{userId}}",
              "host": ["{{base_url}}"],
              "path": ["user", "{{userId}}"]
            },
            "description": "Partially update a user. Requires `admin` role.\n\nOnly include fields you want to change."
          }
        },
        {
          "name": "Delete User (Admin only)",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/user/{{userId}}",
              "host": ["{{base_url}}"],
              "path": ["user", "{{userId}}"]
            },
            "description": "Delete a user by ID. Requires `admin` role.\n\n⚠️ This is a hard delete — irreversible."
          }
        }
      ]
    },
