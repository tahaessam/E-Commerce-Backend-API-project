    {
      "name": "📦 Products",
      "description": "Product management endpoints.\n\n**Create/Update/Delete:** `admin` or `seller`\n**Read:** All authenticated roles\n\n**Prerequisite:** Create a Category, Brand, and Seller first — their IDs are used here.",
      "item": [
        {
          "name": "Create Product",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  const id = json._id || (json.data && json.data._id);",
                  "  if (id) {",
                  "    pm.collectionVariables.set('productId', id);",
                  "    console.log('✅ Saved productId:', id);",
